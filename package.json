{
  "name": "promptel",
  "version": "0.3.0",
  "description": "Declarative prompt engineering framework with native Harmony Protocol support",
  "main": "src/index.js",
  "bin": {
    "promptel": "./src/cli.js"
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "node examples/tests/test_harmony.js && node examples/tests/test_simple_conversion.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "validate": "npm run lint && npm run test",
    "prepublishOnly": "npm run validate"
  },
  "keywords": [
    "llm",
    "prompt-engineering",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "groq",
    "harmony-protocol",
    "chain-of-thought",
    "declarative",
    "prompt",
    "gpt"
  ],
  "author": "Skelf Research",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "chevrotain": "^10.5.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.7.0",
    "harmony-protocol-js": "^0.1.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.64.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "eslint": "^7.32.0",
    "jest": "^27.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skelf-research/promptel.git"
  },
  "bugs": {
    "url": "https://github.com/skelf-research/promptel/issues"
  },
  "homepage": "https://promptel.dev"
}
